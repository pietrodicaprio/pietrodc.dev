{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pietrodc",
  "account_id": "646e0454a81550ecf7f27a9e89e76fcd",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  // Unified adapter entrypoint (Astro 6+). Static assets are wired automatically.
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Keep the short workers.dev preview URL (pietrodc.<subdomain>.workers.dev).
  // The custom domain pietrodc.dev is added later, not here.
  "workers_dev": true,
  "observability": { "enabled": true },

  // Newsletter store (double opt-in subscribers).
  "d1_databases": [
    { "binding": "DB", "database_name": "pietrodc-newsletter", "database_id": "0d9e518e-217d-4159-bc75-d80ffaab2287", "migrations_dir": "migrations" }
  ],

  // Non-secret config. RESEND_API_KEY is a secret, set out of band:
  //   pnpm wrangler secret put RESEND_API_KEY
  // Local dev reads it from .dev.vars (gitignored).
  "vars": {
    // Verified Resend sender. Until pietrodc.dev is verified in Resend, local
    // dev overrides this with onboarding@resend.dev via .dev.vars.
    "RESEND_FROM": "Pietro Di Caprio <newsletter@pietrodc.dev>",
    "RESEND_REPLY_TO": "pietro@fabricators.ltd"
  }
}
