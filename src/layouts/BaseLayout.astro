---
import '@fontsource-variable/inter';
import '@fontsource-variable/jost';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/jetbrains-mono';
// Loaded for the accessibility "dyslexia font" toggle; only rendered when enabled.
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';

import { getLangFromUrl, useTranslations, switchLocalePath, languages } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image path. */
  ogImage?: string;
  /** Keep the page out of search indexes (transactional pages). */
  noindex?: boolean;
}

const { title, description, ogImage, noindex } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = t('site.title');
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} · ${t('site.handle')}`;
const desc = description ?? t('home.sub');

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogImage ?? '/og-default.png', Astro.site).href;

// hreflang alternates for this exact page in every locale.
const alternates = (Object.keys(languages) as Array<keyof typeof languages>).map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(Astro.url, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(switchLocalePath(Astro.url, 'it'), Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={siteName} href={lang === 'it' ? '/rss.xml' : '/en/rss.xml'} />

    {/* Apply saved theme + a11y prefs before paint to avoid flash */}
    <script is:inline>
      (() => {
        try {
          const d = document.documentElement;
          const th = localStorage.getItem('theme');
          if (th === 'light' || th === 'dark') d.setAttribute('data-theme', th);
          const map = {
            'a11y-contrast': 'data-a11y-contrast',
            'a11y-underline': 'data-a11y-underline',
            'a11y-motion': 'data-a11y-motion',
            'a11y-dyslexia': 'data-a11y-dyslexia',
            'a11y-leading': 'data-a11y-leading',
            'a11y-focus': 'data-a11y-focus',
          };
          for (const k in map) {
            const v = localStorage.getItem(k);
            if (v) d.setAttribute(map[k], v);
          }
          const ts = localStorage.getItem('a11y-textsize');
          if (ts) d.style.setProperty('--user-text-scale', ts);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  html {
    font-size: calc(100% * var(--user-text-scale, 1));
  }
</style>
