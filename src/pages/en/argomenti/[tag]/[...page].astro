---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import Archive from '../../../../components/Archive.astro';
import { getPosts, getUsedTags, type Tag } from '../../../../lib/posts';
import { tagLabel } from '../../../../i18n/utils';

export const getStaticPaths = (async ({ paginate }) => {
  const tags = await getUsedTags('en');
  const posts = await getPosts('en');
  return tags.flatMap((tag) =>
    paginate(
      posts.filter((p) => p.data.tag === tag),
      { pageSize: 6, params: { tag } }
    )
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const tag = Astro.params.tag as Tag;
const total = (await getPosts('en')).filter((p) => p.data.tag === tag).length;
---

<SiteLayout title={`${tagLabel(tag, 'en')}`}>
  <Archive lang="en" tag={tag} page={page} total={total} />
</SiteLayout>
