---
import Avatar from './Avatar.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import WavyLines from './WavyLines.astro';
import { aboutContent } from '../i18n/about.ts';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = aboutContent[lang];
const tagSet = new Set(['software', 'prodotto', 'imprenditoria']);

const links: { label: string; value: string; href?: string; icon: IconName; email?: boolean }[] = [
  { label: 'github', value: 'pietrodicaprio', href: 'https://github.com/pietrodicaprio', icon: 'github' },
  { label: 'x', value: '@pietrodc0', href: 'https://x.com/pietrodc0', icon: 'x' },
  { label: 'linkedin', value: 'pietro-di-caprio', href: 'https://www.linkedin.com/in/pietro-di-caprio', icon: 'linkedin' },
  { label: 'mail', value: lang === 'it' ? 'scrivimi' : 'reach me', icon: 'mail', email: true },
  { label: 'rss', value: lang === 'it' ? '/rss.xml' : '/en/rss.xml', href: lang === 'it' ? '/rss.xml' : '/en/rss.xml', icon: 'rss-feed' },
];
---

<div class="about container">
  <div class="about__weave" aria-hidden="true"><WavyLines /></div>

  <header class="about__hero">
    <div class="about__avatar">
      <Avatar size={190} glow alt={`${t('site.title')} — ${c.title}`} />
    </div>
    <div class="about__intro">
      <p class="about__eyebrow">{t('nav.about')}</p>
      <h1 class="about__title">{c.title}</h1>
      <p class="about__tagline">{c.tagline}</p>
      <div class="about__chips">
        {c.chips.map((label) =>
          tagSet.has(label) ? (
            <Chip tag={label as 'software' | 'prodotto' | 'imprenditoria'} label={label} />
          ) : (
            <Chip label={label} neutral />
          )
        )}
      </div>
    </div>
  </header>

  <div class="about__body">
    {c.body.map((p) => <p>{p}</p>)}
  </div>

  <section class="about__elsewhere" aria-labelledby="elsewhere-title">
    <h2 id="elsewhere-title" class="about__elsewheretitle">{c.elsewhere}</h2>
    <div class="about__links">
      {links.map((l) =>
        l.email ? (
          <button type="button" class="about__link" data-email-open>
            <span class="about__linkicon"><Icon name={l.icon} size={18} /></span>
            <span class="about__linklabel">{l.label}</span>
          </button>
        ) : (
          <a class="about__link" href={l.href} rel={l.href?.startsWith('http') ? 'me noopener' : undefined}>
            <span class="about__linkicon"><Icon name={l.icon} size={18} /></span>
            <span class="about__linklabel">{l.label}</span>
          </a>
        )
      )}
    </div>
  </section>
</div>

<style>
  .about {
    position: relative;
    padding-block: var(--space-6) var(--space-6);
  }
  .about__weave {
    position: absolute;
    top: -40px;
    left: 50%;
    width: 100vw;
    height: 520px;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    --wave-opacity: 0.28;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 20%, #000 55%, transparent 95%);
    mask-image: linear-gradient(180deg, transparent, #000 20%, #000 55%, transparent 95%);
  }
  .about > :not(.about__weave) {
    position: relative;
    z-index: 1;
  }

  .about__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-6);
  }
  .about__avatar {
    flex-shrink: 0;
  }
  .about__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .about__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .about__title {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--text);
  }
  .about__tagline {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--text-soft);
  }
  .about__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .about__body {
    max-width: 62ch;
    margin-inline: auto;
    margin-block: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--text);
  }
  .about__body p {
    text-align: justify;
    text-align-last: left;
    hyphens: auto;
  }

  .about__elsewhere {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    text-align: center;
  }
  .about__elsewheretitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .about__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px 8px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
    background: var(--surface-2);
    transition: border-color var(--motion-fast) var(--ease-out), transform var(--motion-fast) var(--ease-out);
  }
  .about__link:hover {
    transform: translateY(-1px);
    border-color: var(--rule-strong);
    opacity: 1;
  }
  .about__linkicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill);
    color: #fff;
    background: var(--brand-gradient);
    flex-shrink: 0;
  }
  .about__linklabel {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  @media (max-width: 620px) {
    .about__hero {
      justify-content: center;
      text-align: center;
    }
    .about__chips {
      justify-content: center;
    }
  }
</style>
