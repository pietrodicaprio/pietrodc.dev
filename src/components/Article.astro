---
import Chip from './Chip.astro';
import Avatar from './Avatar.astro';
import PostCard from './PostCard.astro';
import Lightbox from './Lightbox.astro';
import Icon from './Icon.astro';
import { formatDate, readingTime, type Post } from '../lib/posts';
import { useTranslations, localizePath, tagLabel } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/prose.css';

interface Props {
  post: Post;
  related: Post[];
  lang: Lang;
}
const { post, related, lang } = Astro.props;
const t = useTranslations(lang);
const { tag } = post.data;
const mins = readingTime(post);
const date = formatDate(post.data.pubDate);
---

<article class="article">
  <div class="container article__head">
    <a href={localizePath('/', lang)} class="article__back">
      <span aria-hidden="true">←</span> {t('post.back')}
    </a>
    <div class="article__meta">
      <Chip tag={tag} label={tagLabel(tag, lang)} />
      <span class="article__metaline">{date} · {mins} {t('post.min')}</span>
    </div>
  </div>

  <header class="container article__title">
    <h1>{post.data.title}</h1>
    <p class="article__lead">{post.data.excerpt}</p>
  </header>

  <div class="container article__bodywrap">
    <div class="prose">
      <slot />
    </div>

    <div class="article__sign">
      <div class="article__signwho">
        <Avatar size={34} glow />
        <span>— Pietro · {date}</span>
      </div>
      <div class="article__share" data-share data-url={new URL(Astro.url.pathname, Astro.site).href}>
        <button type="button" class="sharebtn" data-share-native>
          <Icon name="send-diagonal" size={15} /> {t('post.share')}
        </button>
        <button type="button" class="sharebtn" data-share-copy data-copied={t('post.linkCopied')}>
          <Icon name="copy" size={15} /> <span data-copy-label>{t('post.copyLink')}</span>
        </button>
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section class="container article__related" aria-labelledby="related-title">
      <h2 id="related-title" class="article__relatedtitle">{t('post.also')}</h2>
      <div class="article__relatedgrid">
        {related.map((p) => <PostCard post={p} lang={lang} />)}
      </div>
    </section>
  )}
</article>

<Lightbox />

<script>
  const bar = document.querySelector<HTMLElement>('[data-share]');
  if (bar) {
    const url = bar.dataset.url || location.href;
    const nativeBtn = bar.querySelector<HTMLButtonElement>('[data-share-native]');
    const copyBtn = bar.querySelector<HTMLButtonElement>('[data-share-copy]');
    const label = bar.querySelector<HTMLElement>('[data-copy-label]');
    const title = document.title;

    nativeBtn?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {}
      } else {
        copyBtn?.click();
      }
    });

    const COPIED_MS = 1600;
    let timer: ReturnType<typeof setTimeout> | undefined;
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {}
      if (label) {
        const prev = label.dataset.idle || label.textContent || '';
        label.dataset.idle = prev;
        label.textContent = copyBtn.dataset.copied || 'Copied';
      }
      copyBtn.classList.remove('is-done');
      void copyBtn.offsetWidth;
      copyBtn.style.setProperty('--copied-ms', `${COPIED_MS}ms`);
      copyBtn.classList.add('is-done');
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (label) label.textContent = label.dataset.idle || 'Copy link';
        copyBtn.classList.remove('is-done');
      }, COPIED_MS);
    });
  }

  // Scroll-spy: keep the URL hash on the section being read, so a refresh
  // returns to that section instead of the top. Uses replaceState (no history spam).
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')
  );
  if (headings.length) {
    let ticking = false;
    const sync = () => {
      ticking = false;
      const offset = 120;
      let active: HTMLElement | null = null;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= offset) active = h;
        else break;
      }
      const want = active ? `#${active.id}` : '';
      if (want !== location.hash) {
        history.replaceState(null, '', want || location.pathname + location.search);
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true }
    );
  }
</script>

<style>
  .article {
    /* Text column matches the code-block width; media aligns to it */
    --article-measure: 52rem;
    padding-top: var(--space-5);
  }
  .article__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-bottom: var(--space-5);
  }
  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    transition: background var(--motion-fast) var(--ease-out);
  }
  .article__back:hover {
    background: var(--surface-2);
    opacity: 1;
  }
  .article__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .article__metaline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .article__title {
    max-width: var(--article-measure);
    margin-inline: auto;
    padding-block: var(--space-4) var(--space-5);
  }
  .article__title h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-3xl);
    line-height: 1.08;
    color: var(--text);
  }
  .article__lead {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--text-soft);
  }

  .article__bodywrap {
    max-width: var(--article-measure);
    margin-inline: auto;
  }
  .prose {
    padding-block: var(--space-4);
  }

  .article__sign {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--surface-2);
  }
  .article__signwho {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .article__share {
    display: inline-flex;
    gap: var(--space-3);
  }
  .sharebtn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--text-soft);
    transition: background var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);
  }
  .sharebtn:hover {
    background: var(--surface);
    color: var(--text);
  }
  .sharebtn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--chip-software-bg);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .sharebtn.is-done {
    color: var(--chip-software-text);
    border-color: currentColor;
  }
  .sharebtn.is-done::before {
    animation: btn-timer var(--copied-ms, 1600ms) linear forwards;
  }

  .article__related {
    margin-top: var(--space-8);
  }
  .article__relatedtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  .article__relatedgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  @media (max-width: 820px) {
    .article__relatedgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
