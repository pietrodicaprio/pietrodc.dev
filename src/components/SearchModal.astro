---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="smodal" data-search-modal inert>
  <div class="smodal__scrim" data-search-close></div>
  <div class="smodal__card" role="dialog" aria-modal="true" aria-label={t('search.title')}>
    <div class="smodal__inputrow">
      <Icon name="search" size={18} />
      <input
        type="search"
        class="smodal__field"
        data-search-field
        aria-controls="search-results"
        aria-label={t('search.title')}
        placeholder={t('search.placeholder')}
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
      />
      <span class="smodal__count" data-search-count hidden></span>
      <button type="button" class="smodal__esc" data-search-close aria-label={t('search.close')}>esc</button>
    </div>

    <div class="smodal__body" id="search-results" role="listbox" aria-label={t('search.title')} data-search-body></div>

    <div class="smodal__legend">
      <span class="smodal__keys">
        <span><kbd>↵</kbd> {t('search.open')}</span>
        <span><kbd>↑↓</kbd> {t('search.nav')}</span>
        <span><kbd>esc</kbd> {t('search.escLabel')}</span>
      </span>
      <span class="smodal__powered">{t('search.local')}</span>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    labels: {
      results: t('search.results'),
      empty: t('search.empty'),
      hint: t('search.hint'),
      suggestions: t('search.suggestions'),
    },
  }}
>
  (() => {
    const modal = document.querySelector('[data-search-modal]');
    if (!modal) return;
    const field = modal.querySelector('[data-search-field]');
    const body = modal.querySelector('[data-search-body]');
    const countEl = modal.querySelector('[data-search-count]');
    const lang = document.documentElement.lang === 'en' ? 'en' : 'it';

    let items = null;
    let results = [];
    let active = 0;
    let lastFocused = null;

    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    async function load() {
      if (items) return;
      try {
        const res = await fetch('/search-index.json');
        const data = await res.json();
        items = data[lang] || [];
      } catch {
        items = [];
      }
    }

    function highlight(title, tokens) {
      let out = esc(title);
      for (const tk of tokens) {
        if (!tk) continue;
        const re = new RegExp('(' + tk.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
        out = out.replace(re, '<mark>$1</mark>');
      }
      return out;
    }

    function search(q) {
      const query = norm(q.trim());
      const tokens = query.split(/\s+/).filter(Boolean);
      if (!tokens.length) return (items || []).slice(0, 6);
      const scored = [];
      for (const it of items || []) {
        const title = norm(it.title);
        const excerpt = norm(it.excerpt);
        const tag = norm(it.tag);
        const text = norm(it.text || '');
        let score = 0;
        for (const tk of tokens) {
          if (title.includes(tk)) score += 4;
          if (excerpt.includes(tk)) score += 2;
          if (tag.includes(tk)) score += 2;
          if (text.includes(tk)) score += 1;
        }
        if (score > 0) scored.push({ it, score });
      }
      scored.sort((a, b) => b.score - a.score);
      return scored.slice(0, 8).map((s) => s.it);
    }

    function render() {
      const q = field.value.trim();
      const tokens = norm(q).split(/\s+/).filter(Boolean);
      if (!q) {
        countEl.hidden = true;
      } else {
        countEl.hidden = false;
        countEl.textContent = results.length + ' ' + labels.results;
      }
      if (!results.length) {
        body.innerHTML =
          '<p class="smodal__msg">' + (q ? labels.empty : labels.hint) + '</p>';
        return;
      }
      body.innerHTML = results
        .map((it, i) => {
          const meta = it.tag + ' · ' + it.date + ' · ' + it.mins + ' min';
          return (
            '<a class="sresult" role="option" data-tag="' + it.tag + '" href="' + it.url + '"' +
            ' data-i="' + i + '" aria-selected="' + (i === active) + '">' +
            '<span class="sresult__bar"></span>' +
            '<span class="sresult__main"><span class="sresult__title">' + highlight(it.title, tokens) + '</span>' +
            '<span class="sresult__meta">' + esc(meta) + '</span></span>' +
            '<kbd class="sresult__enter">↵</kbd></a>'
          );
        })
        .join('');
      body.querySelectorAll('.sresult').forEach((el) => {
        el.addEventListener('mousemove', () => setActive(Number(el.dataset.i)));
      });
    }

    function setActive(i) {
      active = Math.max(0, Math.min(results.length - 1, i));
      body.querySelectorAll('.sresult').forEach((el, idx) => {
        el.setAttribute('aria-selected', String(idx === active));
        if (idx === active) el.scrollIntoView({ block: 'nearest' });
      });
    }

    function update() {
      results = search(field.value);
      active = 0;
      render();
    }

    async function open() {
      lastFocused = document.activeElement;
      await load();
      modal.removeAttribute('inert');
      modal.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      field.value = '';
      update();
      field.focus();
      document.addEventListener('keydown', onKey);
    }
    function close() {
      modal.removeAttribute('data-open');
      modal.setAttribute('inert', '');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    function onKey(e) {
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        const el = body.querySelector('.sresult[aria-selected="true"]');
        if (el) {
          e.preventDefault();
          window.location.href = el.getAttribute('href');
        }
      }
    }

    field.addEventListener('input', update);
    document.querySelectorAll('[data-search-open]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      })
    );
    modal.querySelectorAll('[data-search-close]').forEach((el) => el.addEventListener('click', close));

    // Global ⌘K / Ctrl+K
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (modal.hasAttribute('data-open')) close();
        else open();
      }
    });
  })();
</script>

<style is:global>
  .smodal {
    position: fixed;
    inset: 0;
    z-index: 75;
    display: grid;
    place-items: start center;
    padding: clamp(var(--space-4), 8vh, var(--space-9)) var(--space-4) var(--space-4);
    visibility: hidden;
    opacity: 0;
    transition: opacity 180ms var(--ease-out), visibility 0s linear 180ms;
  }
  .smodal[data-open] {
    visibility: visible;
    opacity: 1;
    transition: opacity 180ms var(--ease-out), visibility 0s;
  }
  .smodal__scrim {
    position: absolute;
    inset: 0;
    background: rgba(20, 9, 42, 0.4);
    backdrop-filter: blur(6px);
  }
  .smodal__card {
    position: relative;
    width: min(600px, 100%);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 100px -20px rgba(31, 20, 54, 0.5);
    overflow: hidden;
    transform: translateY(-8px) scale(0.99);
    transition: transform 200ms var(--ease-out);
  }
  .smodal[data-open] .smodal__card {
    transform: none;
  }
  :root[data-theme='dark'] .smodal__card {
    background: #1a1330;
  }
  .smodal__inputrow {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--rule);
    color: var(--accent-text);
  }
  .smodal__field {
    flex: 1;
    border: none;
    background: none;
    font: inherit;
    font-size: var(--text-lg);
    color: var(--text);
    outline: none;
  }
  .smodal__field::placeholder {
    color: var(--text-muted);
  }
  .smodal__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--chip-software-bg);
    color: var(--chip-software-text);
    white-space: nowrap;
  }
  .smodal__esc {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 3px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    color: var(--text-muted);
  }
  .smodal__body {
    overflow-y: auto;
    padding: 8px;
  }
  .smodal__msg {
    padding: 24px 14px;
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .sresult {
    display: grid;
    grid-template-columns: 3px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
  }
  .sresult[aria-selected='true'] {
    background: linear-gradient(90deg, var(--chip-software-bg), transparent);
  }
  .sresult__bar {
    align-self: stretch;
    border-radius: 3px;
    background: var(--brand-gradient);
  }
  .sresult[data-tag='prodotto'] .sresult__bar {
    background: linear-gradient(180deg, #e8557f, #f19b7c);
  }
  .sresult[data-tag='imprenditoria'] .sresult__bar {
    background: linear-gradient(180deg, #f19b7c, #fbba7c);
  }
  .sresult[data-tag='community'] .sresult__bar {
    background: linear-gradient(180deg, #7c4fdb, #8f9bff);
  }
  .sresult__main {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .sresult__title {
    color: var(--text);
    font-size: var(--text-base);
  }
  .sresult__title mark {
    background: linear-gradient(120deg, rgba(124, 79, 219, 0.28), rgba(232, 85, 127, 0.28));
    color: inherit;
    border-radius: 4px;
    padding: 0 2px;
  }
  .sresult__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .sresult__enter {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
    opacity: 0;
  }
  .sresult[aria-selected='true'] .sresult__enter {
    opacity: 1;
  }
  .smodal__legend {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 12px 18px;
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .smodal__keys {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .smodal__legend kbd {
    padding: 2px 6px;
    border: 1px solid var(--rule-strong);
    border-radius: 5px;
    color: var(--accent-text);
    background: var(--surface);
  }
  @media (max-width: 480px) {
    .smodal__powered {
      display: none;
    }
  }
</style>
