---
import PostCard from './PostCard.astro';
import Chip from './Chip.astro';
import Pagination from './Pagination.astro';
import { readingTime, type Post } from '../lib/posts';
import { useTranslations, localizePath, tagLabel } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

type Tag = 'software' | 'prodotto' | 'imprenditoria' | 'community';

interface Props {
  lang: Lang;
  tag: Tag;
  page: { data: Post[]; currentPage: number; lastPage: number };
  total: number;
}
const { lang, tag, page, total } = Astro.props;
const t = useTranslations(lang);
const tags: Tag[] = ['software', 'prodotto', 'imprenditoria', 'community'];
const totalMins = page.data.reduce((s, p) => s + readingTime(p), 0);
const makeUrl = (n: number) =>
  localizePath(n === 1 ? `/argomenti/${tag}` : `/argomenti/${tag}/${n}`, lang);
---

<div class="archive container">
  <header class="archive__head">
    <p class="archive__eyebrow">{t('nav.tags')}</p>
    <h1 class="archive__title">{tagLabel(tag, lang)}</h1>
  </header>

  <section class="filter" aria-label={t('nav.tags')}>
    <span class="filter__label">{t('nav.tags')} /</span>
    <Chip label={t('home.allTag')} href={localizePath('/', lang)} neutral />
    {tags.map((tg) => (
      <Chip tag={tg} label={tagLabel(tg, lang)} href={localizePath(`/argomenti/${tg}`, lang)} active={tg === tag} />
    ))}
    <span class="filter__spacer"></span>
    <span class="filter__count">
      {String(total).padStart(2, '0')} {t('home.counter.posts')}
    </span>
  </section>

  <section class="grid" aria-label={tagLabel(tag, lang)}>
    {page.data.map((post) => <PostCard post={post} lang={lang} />)}
  </section>

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} makeUrl={makeUrl} lang={lang} />
</div>

<style>
  .archive {
    padding-block: var(--space-6);
  }
  .archive__head {
    padding-block: var(--space-4) var(--space-5);
  }
  .archive__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .archive__title {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--text);
    text-transform: capitalize;
  }

  .filter {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-block: var(--space-4);
    border-block: 1px solid var(--rule);
  }
  .filter__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: var(--space-2);
  }
  .filter__spacer {
    flex: 1;
  }
  .filter__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
  }
  @media (max-width: 680px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .filter__spacer {
      display: none;
    }
  }
</style>
